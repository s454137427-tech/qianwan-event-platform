# Copy to deploy/.env.production on the deployment host; never commit real secrets.
NODE_ENV=production
APP_ORIGIN=https://event.example.com
ALLOW_DEV_LOGIN=false
STORAGE_DRIVER=cos
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_SIZE=12
REDIS_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
WECHAT_APPID=
WECHAT_SECRET=
# QR login uses official-account OAuth on the scanning phone, then browser confirmation.
# Callback: APP_ORIGIN/api/auth/wechat/callback
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ORGANIZER_NAME=
CONTACT_TEXT=
PRIVACY_NOTICE=
RULES_CONFIRMED=false
MAX_VIDEO_MB=500
VIDEO_EXPECTED_SECONDS=180
DATA_RETENTION_DAYS=15
EVENT_END_AT=
USER_UPLOAD_QUOTA_MB=3072
USER_UPLOAD_MAX_FILES=50
TOTAL_UPLOAD_CAPACITY_GB=1024
# Registration, film submission and voting deadlines. Use full ISO timestamps with +08:00. Actual cutoffs require organizer confirmation.
REGISTRATION_DEADLINE=
FILM_DEADLINE=
VOTING_DEADLINE=
# Optional. Enable only after private COS origin and TypeA authentication are ready.
VIDEO_CDN_ORIGIN=
VIDEO_CDN_AUTH_KEY=
VIDEO_CDN_AUTH_TTL=600
VIDEO_CDN_AUTH_CONFIRMED=false
