# Copy to deploy/.env.production on the deployment host; never commit real secrets.
NODE_ENV=production
APP_ORIGIN=https://mega.gynnai.com
ALLOW_DEV_LOGIN=false
STORAGE_DRIVER=tos
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_SIZE=12
REDIS_URL=
TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=
TOS_BUCKET=
TOS_REGION=
TOS_ENDPOINT=
TOS_UPLOAD_ROLE_TRN=
TOS_PUBLIC_ORIGIN=https://media.gynnai.com
WECHAT_APPID=
WECHAT_SECRET=
# QR login uses official-account OAuth on the scanning phone, then browser confirmation.
# Callback: APP_ORIGIN/api/auth/wechat/callback
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ORGANIZER_NAME=
CONTACT_TEXT=
PRIVACY_NOTICE=
RULES_CONFIRMED=false
MAX_VIDEO_MB=500
VIDEO_EXPECTED_SECONDS=180
DATA_RETENTION_DAYS=15
EVENT_END_AT=
USER_UPLOAD_QUOTA_MB=3072
USER_UPLOAD_MAX_FILES=50
TOTAL_UPLOAD_CAPACITY_GB=1024
# Registration, film submission and voting deadlines. Use full ISO timestamps with +08:00. Actual cutoffs require organizer confirmation.
REGISTRATION_DEADLINE=
FILM_DEADLINE=
VOTING_DEADLINE=
# TOS使用绑定私有桶的HTTPS自定义域名；旧VIDEO_CDN_*已禁用，不填CDN域名。

# 同机数据库扩展才需要；密码须URL编码后填入连接串，详见火山TOS接入.md。
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
