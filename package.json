{
  "name": "qianwan-event-platform",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "setup": "node scripts/setup.js",
    "check": "node scripts/check-source.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write server.js lib scripts test web package.json .prettierrc.json deploy/compose.yaml",
    "format:check": "prettier --check server.js lib scripts test web package.json .prettierrc.json deploy/compose.yaml",
    "deploy:check": "node --env-file=deploy/.env.production scripts/check-deployment.js",
    "deploy:prepare": "node --env-file=deploy/.env.production scripts/prepare-deployment.js",
    "release": "node scripts/package-release.js"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "cos-js-sdk-v5": "^1.10.1",
    "cos-nodejs-sdk-v5": "^2.14.7",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "qcloud-cos-sts": "^3.1.1",
    "qrcode": "^1.5.4",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
