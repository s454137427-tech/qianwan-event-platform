# 本地预览无需修改。正式接入时复制为 .env，填写真实配置。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
ALLOW_DEV_LOGIN=false
STORAGE_DRIVER=local
# 生产环境必须使用 PostgreSQL、COS、Redis、HTTPS 与真实微信登录。
# NODE_ENV=production
# HOST=0.0.0.0
# APP_ORIGIN=https://event.example.com
# ALLOW_DEV_LOGIN=false
# DATABASE_URL=postgresql://user:password@db-host:5432/event
# DATABASE_SSL=true
# REDIS_URL=redis://redis-host:6379
# STORAGE_DRIVER=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-shanghai
# WECHAT_APPID=
# WECHAT_SECRET=
# 微信扫码后，通过具备网页授权能力的公众号授权并确认原网页登录。
# 回调：APP_ORIGIN/api/auth/wechat/callback；无需另填网站应用AppID。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=填写至少16位的随机密码
# TRUST_PROXY_HOPS=1
# ORGANIZER_NAME=填写实际活动运营主体
# CONTACT_TEXT=填写工作人员咨询方式
# PRIVACY_NOTICE="填写正式材料使用说明，包含用途、访问范围、保留期限和联系渠道"
# RULES_CONFIRMED=true
MAX_VIDEO_MB=500
VIDEO_EXPECTED_SECONDS=180
DATA_RETENTION_DAYS=15
# 实际活动结束时间待甲方确认；此配置用于保留计划，不自动删除资料。
EVENT_END_AT=
USER_UPLOAD_QUOTA_MB=3072
USER_UPLOAD_MAX_FILES=50
# 逻辑上传容量预留上限，不等于COS账单容量或费用上限。
TOTAL_UPLOAD_CAPACITY_GB=1024
DB_POOL_SIZE=12
# 可选：云端配置好私有回源、全路径TypeA鉴权后再启用。
# VIDEO_CDN_ORIGIN=https://video.example.com
# VIDEO_CDN_AUTH_KEY=填写6至40位大小写字母和数字
# VIDEO_CDN_AUTH_TTL=600
# VIDEO_CDN_AUTH_CONFIRMED=true
# 影像报名、投稿与投票截止时间为空表示预览阶段开放，不虚构现场活动时间。
REGISTRATION_DEADLINE=
FILM_DEADLINE=
VOTING_DEADLINE=
